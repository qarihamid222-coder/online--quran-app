# Server-side only. Never prefix with NEXT_PUBLIC_ and never commit a real key.
# Enables the website chat assistant (app/api/chat). Without it, the chat shows a
# WhatsApp fallback and the rest of the site works as normal.
OPENAI_API_KEY=
# Optional. Defaults to gpt-4o-mini.
OPENAI_MODEL=
# Optional. The live site address (for example https://www.example.com), used to build
# absolute URLs for social-share images. On Vercel the production URL is used if unset.
NEXT_PUBLIC_SITE_URL=
